{
  // Static assets only — there is no Worker script and no build step. Everything
  // under public/ is uploaded as-is and served from Cloudflare's edge, with
  // public/index.html answering "/".
  //
  // The directory is deliberately not the repo root: wrangler's only built-in
  // ignores are .assetsignore, _redirects and _headers, so a root upload would
  // publish .git — the whole history — unless an ignore file caught it. A
  // directory that holds nothing but the site cannot leak by omission.
  "name": "painterly",
  "compatibility_date": "2025-09-10",
  "assets": {
    "directory": "./public"
  }
}
